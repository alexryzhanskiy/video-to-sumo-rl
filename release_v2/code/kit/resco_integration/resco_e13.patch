+def masked_batch_act(dqn, batch_obs, batch_legal):    # E13: greedy or epsilon-random among legal actions
+    with torch.no_grad(), evaluating(dqn.model):
+        batch_av = dqn._evaluate_model_and_update_recurrent_states(batch_obs)
+        q = batch_av.q_values.detach().cpu().numpy()
+    acts = []
+    for i, legal in enumerate(batch_legal):
+        act = max(legal, key=lambda a: q[i][a])    # ties: first legal action
+        if dqn.training:
+            dqn.explorer.epsilon = dqn.explorer.compute_epsilon(dqn.t)
+            if np.random.rand() < dqn.explorer.epsilon:
+                act = legal[np.random.randint(len(legal))]
+        acts.append(int(act))
+    if dqn.training:
+        dqn.batch_last_obs = list(batch_obs)
+        dqn.batch_last_action = list(acts)
+    return acts
