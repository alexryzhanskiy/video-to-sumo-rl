+def pressure_norm(signals):
+    # Нормированная max-pressure награда (throughput-aware): -очередь/число полос.
+    # Для изолированного перекрёстка (без downstream) = минимизация суммарной очереди,
+    # что по теории max-pressure максимизирует пропускную под насыщением.
+    rewards = dict()
+    for signal_id in signals:
+        q = 0
+        for lane in signals[signal_id].lanes:
+            q += signals[signal_id].full_observation[lane]['queue']
+        rewards[signal_id] = -q / max(1, len(signals[signal_id].lanes))
+    return rewards
+
