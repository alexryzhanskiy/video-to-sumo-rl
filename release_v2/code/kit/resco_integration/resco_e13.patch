+def drq_norm1_pt(signals):    # E13: drq_norm1 + one row: elapsed green / 60 s and green-phase one-hot
+    observations = drq_norm1(signals)
+    for signal_id in observations:
+        signal = signals[signal_id]
+        obs = observations[signal_id]
+        row = np.zeros(obs.shape[-1])
+        assert 2 + signal.green_phase < len(row)
+        row[1] = signal.green_elapsed() / 60.0
+        row[2 + signal.green_phase] = 1.0
+        observations[signal_id] = np.concatenate([obs, row[None, None, :]], axis=1)
+    return observations
